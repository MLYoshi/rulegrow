# RuleGrow fixed sandbox image.
# Contains ONLY a pinned Python and the fixed executor entrypoint.
# AI-generated rule files are mounted read-only at runtime; they are never
# baked into this image.
# NOTE: for reproducibility, pin this to a digest you have verified locally:
#   docker images --digests python
FROM python:3.12.7-slim

RUN groupadd -g 10001 runner && useradd -u 10001 -g 10001 -m -s /usr/sbin/nologin runner

COPY runner/entrypoint.py /app/entrypoint.py

USER 10001:10001
WORKDIR /app

# Protocol: read task JSON from argv[1], write result JSON to stdout only.
ENTRYPOINT ["python", "-I", "/app/entrypoint.py"]
